# The packages of NeuroLang, from the top: each imports only the packages
# below it. Tests are checked as part of their package.
#   neurolang_apps  the command line, terminal interface, engines, assistant
#   nl_tracts       tractography: atlases and tractograms as relations
#   neurolang       the language: parsers, frontends, regions, neuroimaging
#   nl_core         relational algebra and its sets, Datalog, probabilistic
#   nl_expr         the expression engine: expressions, walkers, types, logic

[importlinter]
root_packages =
    nl_expr
    nl_core
    neurolang
    nl_tracts
    neurolang_apps
include_external_packages = True

[importlinter:contract:layers]
name = NeuroLang packages: apps > tractography > language > core > expression engine
type = layers
layers =
    neurolang_apps
    nl_tracts
    neurolang
    nl_core
    nl_expr

[importlinter:contract:engine-dependencies]
name = The expression engine needs neither pandas nor the neuroimaging libraries
type = forbidden
source_modules =
    nl_expr
forbidden_modules =
    pandas
    polars
    lark
    nibabel
    nilearn
    rdflib

[importlinter:contract:core-dependencies]
name = The core needs neither the parsers nor the neuroimaging libraries
type = forbidden
source_modules =
    nl_core
forbidden_modules =
    lark
    nibabel
    nilearn

[importlinter:contract:atlases-dependencies]
name = The atlases of neurolang need nothing else of NeuroLang
type = forbidden
source_modules =
    neurolang.atlases
forbidden_modules =
    neurolang.*
    nl_core
    nl_expr
    lark
# but the lazy access to nilearn, to fetch atlases
ignore_imports =
    neurolang.atlases -> neurolang.utils.nilearn_compat

[importlinter:contract:tracts-core-dependencies]
name = The core of nl_tracts needs neither NeuroLang, but its atlases, nor the parsers
type = forbidden
source_modules =
    nl_tracts.terms
    nl_tracts.atlas
    nl_tracts.tractogram
    nl_tracts.indexing
    nl_tracts.cache
    nl_tracts.wmql_vocab
    nl_tracts.cli
    nl_tracts.ids
    nl_tracts.vocabulary
    nl_tracts.fetch
forbidden_modules =
    neurolang
    nl_core
    nl_expr
    lark
    nilearn
# but neurolang.atlases, whose own contract is the one above
ignore_imports =
    nl_tracts.* -> neurolang.atlases
