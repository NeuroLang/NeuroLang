# The packages of NeuroLang, from the top: each imports only the packages
# below it. Tests are checked as part of their package.
#   neurolang_apps  the command line, terminal interface, engines, assistant
#   nl_tracts       tractography: atlases and tractograms as relations
#   neurolang       the language: parsers, frontends, regions, neuroimaging
#   nl_core         relational algebra and its sets, Datalog, probabilistic
#   nl_expr         the expression engine: expressions, walkers, types, logic

[importlinter]
root_packages =
    nl_expr
    nl_core
    neurolang
    nl_tracts
    neurolang_apps
include_external_packages = True

[importlinter:contract:layers]
name = NeuroLang packages: apps > tractography > language > core > expression engine
type = layers
layers =
    neurolang_apps
    nl_tracts
    neurolang
    nl_core
    nl_expr

[importlinter:contract:engine-dependencies]
name = The expression engine needs neither pandas nor the neuroimaging libraries
type = forbidden
source_modules =
    nl_expr
forbidden_modules =
    pandas
    polars
    lark
    nibabel
    nilearn
    rdflib

[importlinter:contract:core-dependencies]
name = The core needs neither the parsers nor the neuroimaging libraries
type = forbidden
source_modules =
    nl_core
forbidden_modules =
    lark
    nibabel
    nilearn

[importlinter:contract:tracts-core-dependencies]
name = The core of nl_tracts needs neither NeuroLang nor the parsers
type = forbidden
source_modules =
    nl_tracts.spaces
    nl_tracts.terms
    nl_tracts.wmql
    nl_tracts.atlas
    nl_tracts.tractogram
    nl_tracts.indexing
    nl_tracts.cache
forbidden_modules =
    neurolang
    nl_core
    nl_expr
    lark
    nilearn
