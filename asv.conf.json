{
    "version": 1,
    "project": "NeuroLang",
    "project_url": "https://github.com/NeuroLang/NeuroLang",
    "repo": ".",
    "show_commit_url": "https://github.com/NeuroLang/NeuroLang/commit/",
    "branches": ["master"],
    "pythons": ["3.14"],
    "environment_type": "virtualenv",
    "matrix": {
        "polars": [""],
        "pyarrow": [""]
    },
    "build_command": [],
    "install_command": [
        "python -m pip install --force-reinstall {build_dir}/packages/nl_expr {build_dir}/packages/nl_core {build_dir}/packages/neurolang"
    ],
    "uninstall_command": [
        "return-code=any python -m pip uninstall -y nl-expr nl-core neurolang"
    ],
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
