% The bundles of tract_querier's mori_queries.qry, in the vocabulary of
%   tractography
% (nl_tracts, DESIGN.md, 17): written by nl_tracts.wmql_vocab, one
% predicate per query of tract_querier's language, WMQL, with the
% statement of WMQL over it. x is a streamline, h a hemisphere,
% "left" or "right" (name.side is name(x, h)); a name of labels is a
% term of the atlas's mapping ("frontal"). The semantics is the
% vocabulary's (DESIGN.md, 16.5); superior_of and inferior_of are
% anatomical (above, below the box of the term): the reverse of
% tract_querier's (DESIGN.md, 15.20).
%
% The terms it uses: angular_gyrus, anterior_corona_radiata,
%   anterior_limb_of_internal_capsule, cerebellum, cerebral_peduncle,
%   cingulate_gyrus, cingulum_cingulate_gyrus, cingulum_hippocampus,
%   corpus_callosum, cuneus, external_capsule, fornix_column_and_body,
%   fornix_cres_stria_terminalis, frontal, globus_pallidus,
%   inferior_cerebellar_peduncle, inferior_frontal_gyrus,
%   inferior_fronto_occipital_fasciculus, insular, lingual_gyrus,
%   medial_lemniscus, middle_frontal_gyrus, middle_occipital_gyrus, occipital,
%   parahippocampal_gyrus, pons, pontine_crossing_tract, postcentral_gyrus,
%   posterior_corona_radiata, posterior_limb_of_internal_capsule, pre_cuneus,
%   precentral_gyrus, putamen, retrolenticular_part_of_internal_capsule,
%   sagittal_stratum, superior_corona_radiata, superior_frontal_gyrus,
%   superior_longitudinal_fasciculus, superior_occipital_gyrus,
%   superior_parietal_lobule, supramarginal_gyrus, temporal, thalamus,
%   uncinate_fasciculus.

% corpus_callosum |= corpus_callosum.left or corpus_callosum.right not in THALAMUS.right\
%     not in THALAMUS.left not in PUTAMEN.right not in PUTAMEN.left not in GLOBUS_PALLIDUS.right not in GLOBUS_PALLIDUS.left\
%     not in PONS.right not in PONS.left not in CEREBELLUM.right not in CEREBELLUM.left \
%     not in Fornix_cres_Stria_terminalis.left not in Fornix_column_and_body.left not in Fornix_cres_Stria_terminalis.right not in Fornix_column_and_body.right
corpus_callosum(x) :-
    (traverses(x, "corpus_callosum", "left")
     | traverses(x, "corpus_callosum", "right")),
    ~traverses(x, "thalamus", "right"), ~traverses(x, "thalamus", "left"),
    ~traverses(x, "putamen", "right"), ~traverses(x, "putamen", "left"),
    ~traverses(x, "globus_pallidus", "right"),
    ~traverses(x, "globus_pallidus", "left"), ~traverses(x, "pons", "right"),
    ~traverses(x, "pons", "left"), ~traverses(x, "cerebellum", "right"),
    ~traverses(x, "cerebellum", "left"),
    ~traverses(x, "fornix_cres_stria_terminalis", "left"),
    ~traverses(x, "fornix_column_and_body", "left"),
    ~traverses(x, "fornix_cres_stria_terminalis", "right"),
    ~traverses(x, "fornix_column_and_body", "right")

% CST.side = Cerebral_peduncle.side and PRECENTRAL_GYRUS.side\
%            not in HEMISPHERE.opposite not in THALAMUS.side\
%            not in CEREBELLUM.side not in MIDDLE_OCCIPITAL_GYRUS.side
cst(x, h) :-
    traverses(x, "cerebral_peduncle", h), traverses(x, "precentral_gyrus", h),
    opposite_hemisphere(h, o), ~in_hemisphere(x, o),
    ~traverses(x, "thalamus", h), ~traverses(x, "cerebellum", h),
    ~traverses(x, "middle_occipital_gyrus", h)

% IFO.side = frontal.side and occipital.side and Sagittal_stratum.side and Inferior_fronto_occipital_fasciculus.side\
%            not in corpus_callosum not in THALAMUS.side not in SUPERIOR_PARIETAL_LOBULE.side not in PRE_CUNEUS.side\
%            not in Superior_corona_radiata.side not in Uncinate_fasciculus.side
ifo(x, h) :-
    traverses(x, "frontal", h), traverses(x, "occipital", h),
    traverses(x, "sagittal_stratum", h),
    traverses(x, "inferior_fronto_occipital_fasciculus", h),
    ~corpus_callosum(x), ~traverses(x, "thalamus", h),
    ~traverses(x, "superior_parietal_lobule", h),
    ~traverses(x, "pre_cuneus", h),
    ~traverses(x, "superior_corona_radiata", h),
    ~traverses(x, "uncinate_fasciculus", h)

% ILF.side = (
%           temporal.side and occipital.side and Sagittal_stratum.side
%           not in HEMISPHERE.opposite not in CEREBELLUM.side not in THALAMUS.side not in corpus_callosum not in frontal.side
%           not in LINGUAL_GYRUS.side
%           not in Inferior_fronto_occipital_fasciculus.side not in Superior_longitudinal_fasciculus.side not in CINGULATE_GYRUS.side
%           not in Anterior_limb_of_internal_capsule.side not in Anterior_corona_radiata.side not in Superior_corona_radiata.side
%           not in Fornix_column_and_body.side not in ANGULAR_GYRUS.side not in PRE_CUNEUS.side not in CUNEUS.side not in SUPRAMARGINAL_GYRUS.side
% )
ilf(x, h) :-
    traverses(x, "temporal", h), traverses(x, "occipital", h),
    traverses(x, "sagittal_stratum", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o), ~traverses(x, "cerebellum", h),
    ~traverses(x, "thalamus", h), ~corpus_callosum(x),
    ~traverses(x, "frontal", h), ~traverses(x, "lingual_gyrus", h),
    ~traverses(x, "inferior_fronto_occipital_fasciculus", h),
    ~traverses(x, "superior_longitudinal_fasciculus", h),
    ~traverses(x, "cingulate_gyrus", h),
    ~traverses(x, "anterior_limb_of_internal_capsule", h),
    ~traverses(x, "anterior_corona_radiata", h),
    ~traverses(x, "superior_corona_radiata", h),
    ~traverses(x, "fornix_column_and_body", h),
    ~traverses(x, "angular_gyrus", h), ~traverses(x, "pre_cuneus", h),
    ~traverses(x, "cuneus", h), ~traverses(x, "supramarginal_gyrus", h)

% UNC.side = frontal.side and temporal.side\
%            not in corpus_callosum not in CEREBELLUM.side not in THALAMUS.side not in Posterior_corona_radiata.side\
%            not in PARAHIPPOCAMPAL_GYRUS.side not in occipital.side\
%            not in Posterior_limb_of_internal_capsule.side not in Retrolenticular_part_of_internal_capsule.side\
%            not in Superior_longitudinal_fasciculus.side not in HEMISPHERE.opposite
unc(x, h) :-
    traverses(x, "frontal", h), traverses(x, "temporal", h),
    ~corpus_callosum(x), ~traverses(x, "cerebellum", h),
    ~traverses(x, "thalamus", h), ~traverses(x, "posterior_corona_radiata", h),
    ~traverses(x, "parahippocampal_gyrus", h), ~traverses(x, "occipital", h),
    ~traverses(x, "posterior_limb_of_internal_capsule", h),
    ~traverses(x, "retrolenticular_part_of_internal_capsule", h),
    ~traverses(x, "superior_longitudinal_fasciculus", h),
    opposite_hemisphere(h, o), ~in_hemisphere(x, o)

% CG.side = CINGULATE_GYRUS.side or Cingulum_cingulate_gyrus.side or Cingulum_hippocampus.side not in corpus_callosum not in HEMISPHERE.opposite
cg(x, h) :-
    (traverses(x, "cingulate_gyrus", h)
     | traverses(x, "cingulum_cingulate_gyrus", h)
     | traverses(x, "cingulum_hippocampus", h)),
    ~corpus_callosum(x), opposite_hemisphere(h, o), ~in_hemisphere(x, o)

% SLF_t.side = frontal.side and temporal.side\
%                not in occipital.side not in corpus_callosum not in CEREBELLUM.side not in Inferior_fronto_occipital_fasciculus.side\
%                not in Anterior_limb_of_internal_capsule.side not in Posterior_limb_of_internal_capsule.side not in INSULAR.side\
%                not in Fornix_column_and_body.side not in External_capsule.side
slf_t(x, h) :-
    traverses(x, "frontal", h), traverses(x, "temporal", h),
    ~traverses(x, "occipital", h), ~corpus_callosum(x),
    ~traverses(x, "cerebellum", h),
    ~traverses(x, "inferior_fronto_occipital_fasciculus", h),
    ~traverses(x, "anterior_limb_of_internal_capsule", h),
    ~traverses(x, "posterior_limb_of_internal_capsule", h),
    ~traverses(x, "insular", h), ~traverses(x, "fornix_column_and_body", h),
    ~traverses(x, "external_capsule", h)

% SLF_fp.side = frontal.side and ANGULAR_GYRUS.side and SUPRAMARGINAL_GYRUS.side \
%                not in occipital.side not in temporal.side\
%                not in corpus_callosum not in CEREBELLUM.side not in Inferior_fronto_occipital_fasciculus.side\
%                not in Anterior_limb_of_internal_capsule.side not in Posterior_limb_of_internal_capsule.side not in INSULAR.side
slf_fp(x, h) :-
    traverses(x, "frontal", h), traverses(x, "angular_gyrus", h),
    traverses(x, "supramarginal_gyrus", h), ~traverses(x, "occipital", h),
    ~traverses(x, "temporal", h), ~corpus_callosum(x),
    ~traverses(x, "cerebellum", h),
    ~traverses(x, "inferior_fronto_occipital_fasciculus", h),
    ~traverses(x, "anterior_limb_of_internal_capsule", h),
    ~traverses(x, "posterior_limb_of_internal_capsule", h),
    ~traverses(x, "insular", h)

% SLF_pt.side = temporal.side and ANGULAR_GYRUS.side \
%                not in occipital.side not in frontal.side\
%                not in corpus_callosum not in CEREBELLUM.side not in Inferior_fronto_occipital_fasciculus.side\
%                not in Anterior_limb_of_internal_capsule.side not in Posterior_limb_of_internal_capsule.side not in INSULAR.side
slf_pt(x, h) :-
    traverses(x, "temporal", h), traverses(x, "angular_gyrus", h),
    ~traverses(x, "occipital", h), ~traverses(x, "frontal", h),
    ~corpus_callosum(x), ~traverses(x, "cerebellum", h),
    ~traverses(x, "inferior_fronto_occipital_fasciculus", h),
    ~traverses(x, "anterior_limb_of_internal_capsule", h),
    ~traverses(x, "posterior_limb_of_internal_capsule", h),
    ~traverses(x, "insular", h)

% thalamic_radiations.side = THALAMUS.side and (
%               SUPERIOR_PARIETAL_LOBULE.side or \
%               SUPERIOR_FRONTAL_GYRUS.side or MIDDLE_FRONTAL_GYRUS.side or INFERIOR_FRONTAL_GYRUS.side or \
%               PRECENTRAL_GYRUS.side or POSTCENTRAL_GYRUS.side or \
%               PRE_CUNEUS.side or \
%               SUPERIOR_OCCIPITAL_GYRUS.side or MIDDLE_OCCIPITAL_GYRUS.side )  not in \
%               Pontine_crossing_tract.side not in Inferior_cerebellar_peduncle.side not in Medial_lemniscus.side not in \
%               corpus_callosum not in temporal.side not in CEREBELLUM.side not in HEMISPHERE.opposite not in Cerebral_peduncle.side
thalamic_radiations(x, h) :-
    traverses(x, "thalamus", h),
    (traverses(x, "superior_parietal_lobule", h)
     | traverses(x, "superior_frontal_gyrus", h)
     | traverses(x, "middle_frontal_gyrus", h)
     | traverses(x, "inferior_frontal_gyrus", h)
     | traverses(x, "precentral_gyrus", h)
     | traverses(x, "postcentral_gyrus", h) | traverses(x, "pre_cuneus", h)
     | traverses(x, "superior_occipital_gyrus", h)
     | traverses(x, "middle_occipital_gyrus", h)),
    ~traverses(x, "pontine_crossing_tract", h),
    ~traverses(x, "inferior_cerebellar_peduncle", h),
    ~traverses(x, "medial_lemniscus", h), ~corpus_callosum(x),
    ~traverses(x, "temporal", h), ~traverses(x, "cerebellum", h),
    opposite_hemisphere(h, o), ~in_hemisphere(x, o),
    ~traverses(x, "cerebral_peduncle", h)
