% The bundles of tract_querier's freesurfer_queries.qry, with the terms of
%   freesurfer_aseg_aparc, in the vocabulary of tractography
% (nl_tracts, DESIGN.md, 17): written by nl_tracts.wmql_vocab, one
% predicate per query of tract_querier's language, WMQL, with the
% statement of WMQL over it. x is a streamline, h a hemisphere,
% "left" or "right" (name.side is name(x, h)); a name of labels is a
% term of the atlas's mapping ("frontal"). The semantics is the
% vocabulary's (DESIGN.md, 16.5); superior_of and inferior_of are
% anatomical (above, below the box of the term): the reverse of
% tract_querier's (DESIGN.md, 15.20).
%
% The terms it uses: amygdala, bankssts, brain_stem, caudalanteriorcingulate,
%   caudalmiddlefrontal, centrum_semiovale, cerebellum,
%   cerebellum_white_matter, cingular, cingular_cortex, corpus_callosum,
%   corpuscallosum, cuneus, entorhinal, frontal, frontalpole, fusiform,
%   hippocampus, inferior_frontal_gyrus, inferiorparietal, inferiortemporal,
%   insula, isthmuscingulate, lateraloccipital, lateralorbitofrontal, lingual,
%   medialorbitofrontal, middle_frontal_gyrus, middletemporal, occipital,
%   orbitofrontalgyrus, paracentral, parahippocampal, parietal,
%   parsopercularis, parsorbitalis, parstriangularis, postcentral,
%   posteriorcingulate, precentral, precuneus, putamen,
%   rostralanteriorcingulate, rostralmiddlefrontal, striatum, subcortical,
%   superior_parietal_lobule, superiorfrontal, superiorparietal,
%   superiortemporal, supramarginal, temporal, temporalpole, thalamus_proper,
%   transversetemporal, unsegmentedwhitematter.

% precentral_postcentral.side |= only(precentral.side and postcentral.side and centrum_semiovale.side)
precentral_postcentral_leaves(x, h) :-
    in_hemisphere(x, h), streamline_label(a, x, l),
    ~term_label(a, l, "precentral", h), ~term_label(a, l, "postcentral", h),
    ~term_label(a, l, "centrum_semiovale", h)
precentral_postcentral(x, h) :-
    traverses(x, "precentral", h), traverses(x, "postcentral", h),
    traverses(x, "centrum_semiovale", h), ~precentral_postcentral_leaves(x, h)

% internal_capsule_new.side = ((frontal.side and thalamus_proper.side and (parietal.side or occipital.side))
%     not in cingular.side
%     not in precentral.side not in postcentral.side
%     not in hemisphere.opposite
%     not in brain_stem
%     )
internal_capsule_new(x, h) :-
    traverses(x, "frontal", h), traverses(x, "thalamus_proper", h),
    (traverses(x, "parietal", h) | traverses(x, "occipital", h)),
    ~traverses(x, "cingular", h), ~traverses(x, "precentral", h),
    ~traverses(x, "postcentral", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o), ~traverses(x, "brain_stem", _)

% cst_pre.side |= ((precentral.side and brain_stem)
%     not in superiorfrontal.side
%     not in cerebellum_white_matter.side not in thalamus_proper.side
%     not in hemisphere.opposite)
cst_pre(x, h) :-
    traverses(x, "precentral", h), traverses(x, "brain_stem", _),
    ~traverses(x, "superiorfrontal", h),
    ~traverses(x, "cerebellum_white_matter", h),
    ~traverses(x, "thalamus_proper", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o)

% cst_post.side |= ((postcentral.side and brain_stem)
%     not in superiorfrontal.side
%     not in cerebellum_white_matter.side not in thalamus_proper.side
%     not in hemisphere.opposite)
cst_post(x, h) :-
    traverses(x, "postcentral", h), traverses(x, "brain_stem", _),
    ~traverses(x, "superiorfrontal", h),
    ~traverses(x, "cerebellum_white_matter", h),
    ~traverses(x, "thalamus_proper", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o)

% cst.side = cst_pre.side or cst_post.side
cst(x, h) :-
    (cst_pre(x, h) | cst_post(x, h))

% cb.side = only((cingular.side or cingular_cortex.side) and (middle_frontal_gyrus.side or cuneus.side or entorhinal.side or superiorfrontal.side or inferiorparietal.side or fusiform.side or medialorbitofrontal.side or lateralorbitofrontal.side or unsegmentedwhitematter.side or parahippocampal.side or precuneus.side or lingual.side))
cb_leaves(x, h) :-
    in_hemisphere(x, h), streamline_label(a, x, l),
    ~term_label(a, l, "cingular", h), ~term_label(a, l, "cingular_cortex", h),
    ~term_label(a, l, "middle_frontal_gyrus", h),
    ~term_label(a, l, "cuneus", h), ~term_label(a, l, "entorhinal", h),
    ~term_label(a, l, "superiorfrontal", h),
    ~term_label(a, l, "inferiorparietal", h), ~term_label(a, l, "fusiform", h),
    ~term_label(a, l, "medialorbitofrontal", h),
    ~term_label(a, l, "lateralorbitofrontal", h),
    ~term_label(a, l, "unsegmentedwhitematter", h),
    ~term_label(a, l, "parahippocampal", h), ~term_label(a, l, "precuneus", h),
    ~term_label(a, l, "lingual", h)
cb(x, h) :-
    (traverses(x, "cingular", h) | traverses(x, "cingular_cortex", h)),
    (traverses(x, "middle_frontal_gyrus", h) | traverses(x, "cuneus", h)
     | traverses(x, "entorhinal", h) | traverses(x, "superiorfrontal", h)
     | traverses(x, "inferiorparietal", h) | traverses(x, "fusiform", h)
     | traverses(x, "medialorbitofrontal", h)
     | traverses(x, "lateralorbitofrontal", h)
     | traverses(x, "unsegmentedwhitematter", h)
     | traverses(x, "parahippocampal", h) | traverses(x, "precuneus", h)
     | traverses(x, "lingual", h)),
    ~cb_leaves(x, h)

% ioff.side = (
%             (lateralorbitofrontal.side and occipital.side)
%             and temporal.side
%         not in subcortical.side
%     not in cingular.side
%     not in superior_parietal_lobule.side
%     not in hemisphere.opposite
% )
ioff(x, h) :-
    traverses(x, "lateralorbitofrontal", h), traverses(x, "occipital", h),
    traverses(x, "temporal", h), ~traverses(x, "subcortical", h),
    ~traverses(x, "cingular", h), ~traverses(x, "superior_parietal_lobule", h),
    opposite_hemisphere(h, o), ~in_hemisphere(x, o)

% soff.side = (
%             (lateralorbitofrontal.side and occipital.side)
%     not in temporal.side
%         not in subcortical.side
%     not in cingular.side
%     not in hemisphere.opposite
% )
soff(x, h) :-
    traverses(x, "lateralorbitofrontal", h), traverses(x, "occipital", h),
    ~traverses(x, "temporal", h), ~traverses(x, "subcortical", h),
    ~traverses(x, "cingular", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o)

% UF.side = (
%     (
%     (orbitofrontalgyrus.side or middle_frontal_gyrus.side  or inferior_frontal_gyrus.side)
%     and endpoints_in(temporal.side and anterior_of(amygdala.side))
%     and insula.side
%     )
%     not in occipital.side not in parietal.side not in cingular.side
%         not in posterior_of(putamen.side)
%     not in HEMISPHERE.opposite)
uf(x, h) :-
    (traverses(x, "orbitofrontalgyrus", h)
     | traverses(x, "middle_frontal_gyrus", h)
     | traverses(x, "inferior_frontal_gyrus", h)),
    endpoint_in(x, e, "temporal", h),
    endpoint_anterior_of(x, e, "amygdala", h), traverses(x, "insula", h),
    ~traverses(x, "occipital", h), ~traverses(x, "parietal", h),
    ~traverses(x, "cingular", h), ~posterior_of(x, "putamen", h),
    opposite_hemisphere(h, o), ~in_hemisphere(x, o)

% MDLF.side = only(
%         (
%             temporalpole.side or superiortemporal.side
%         )  and
%         (
%             inferiorparietal.side or
%             superiorparietal.side or
%             supramarginal.side or
%             precuneus.side or
%             (centrum_semiovale.side and superiorparietal.side) or
%             (centrum_semiovale.side and inferiorparietal.side)
%         )
%     )
mdlf_leaves(x, h) :-
    in_hemisphere(x, h), streamline_label(a, x, l),
    ~term_label(a, l, "temporalpole", h),
    ~term_label(a, l, "superiortemporal", h),
    ~term_label(a, l, "inferiorparietal", h),
    ~term_label(a, l, "superiorparietal", h),
    ~term_label(a, l, "supramarginal", h), ~term_label(a, l, "precuneus", h),
    ~term_label(a, l, "centrum_semiovale", h)
mdlf(x, h) :-
    (traverses(x, "temporalpole", h) | traverses(x, "superiortemporal", h)),
    (traverses(x, "inferiorparietal", h) | traverses(x, "superiorparietal", h)
     | traverses(x, "supramarginal", h) | traverses(x, "precuneus", h)
     | (traverses(x, "centrum_semiovale", h),
        traverses(x, "superiorparietal", h))
     | (traverses(x, "centrum_semiovale", h),
        traverses(x, "inferiorparietal", h))),
    ~mdlf_leaves(x, h)

% ILF.side = endpoints_in(temporal.side and anterior_of(hippocampus.side)) and endpoints_in(occipital.side)
ilf(x, h) :-
    endpoint_in(x, e, "temporal", h),
    endpoint_anterior_of(x, e, "hippocampus", h), ends_in(x, "occipital", h)

% ec.side = (
%   (superiortemporal.side and frontal.side) and (parietal.side or occipital.side)
%   not in ioff.side not in ilf.side
%   not in hemisphere.opposite not in subcortical.side not in uf.side
%   not in inferiortemporal.side  not in fusiform.side not in middletemporal.side not in temporalpole.side
%   not in corpuscallosum.side
%   not in precentral.side not in parsopercularis.side
%   not in cingular.side
% )
ec(x, h) :-
    traverses(x, "superiortemporal", h), traverses(x, "frontal", h),
    (traverses(x, "parietal", h) | traverses(x, "occipital", h)), ~ioff(x, h),
    ~ilf(x, h), opposite_hemisphere(h, o), ~in_hemisphere(x, o),
    ~traverses(x, "subcortical", h), ~uf(x, h),
    ~traverses(x, "inferiortemporal", h), ~traverses(x, "fusiform", h),
    ~traverses(x, "middletemporal", h), ~traverses(x, "temporalpole", h),
    ~traverses(x, "corpuscallosum", h), ~traverses(x, "precentral", h),
    ~traverses(x, "parsopercularis", h), ~traverses(x, "cingular", h)

% SLF_I.side = (
%         ((superiorparietal.side and precuneus.side and superiorfrontal.side)
%     or (superiorparietal.side and precuneus.side and superiorfrontal.side
%     and lateraloccipital.side))
%         not in cingular.side
%         not in temporal.side
%         not in subcortical.side
%         not in HEMISPHERE.opposite
%       )
slf_i(x, h) :-
    ((traverses(x, "superiorparietal", h), traverses(x, "precuneus", h),
      traverses(x, "superiorfrontal", h))
     | (traverses(x, "superiorparietal", h), traverses(x, "precuneus", h),
        traverses(x, "superiorfrontal", h),
        traverses(x, "lateraloccipital", h))),
    ~traverses(x, "cingular", h), ~traverses(x, "temporal", h),
    ~traverses(x, "subcortical", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o)

% slf_ii.side = ((
%     (lateraloccipital.side or supramarginal.side or inferiorparietal.side) and
%     endpoints_in(middle_frontal_gyrus.side))
%     not in hemisphere.opposite not in temporal.side not in cingular.side not in subcortical.side)
slf_ii(x, h) :-
    (traverses(x, "lateraloccipital", h) | traverses(x, "supramarginal", h)
     | traverses(x, "inferiorparietal", h)),
    ends_in(x, "middle_frontal_gyrus", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o), ~traverses(x, "temporal", h),
    ~traverses(x, "cingular", h), ~traverses(x, "subcortical", h)

% slf_iii.side = ((
%     (lateraloccipital.side or supramarginal.side or inferiorparietal.side) and
%     endpoints_in(inferior_frontal_gyrus.side))
%     not in hemisphere.opposite not in temporal.side not in cingular.side not in subcortical.side)
slf_iii(x, h) :-
    (traverses(x, "lateraloccipital", h) | traverses(x, "supramarginal", h)
     | traverses(x, "inferiorparietal", h)),
    ends_in(x, "inferior_frontal_gyrus", h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o), ~traverses(x, "temporal", h),
    ~traverses(x, "cingular", h), ~traverses(x, "subcortical", h)

% extreme_capsule.side = (((superiortemporal.side or temporalpole.side)
%     and (inferior_frontal_gyrus.side or middle_frontal_gyrus.side) and inferiorparietal.side)
%     not in MDLF.side
%     not in SLF_I.side
%         not in SLF_II.side
%     not in SLF_III.side
%         not in IOFF.side
%         not in HEMISPHERE.opposite
% )
extreme_capsule(x, h) :-
    (traverses(x, "superiortemporal", h) | traverses(x, "temporalpole", h)),
    (traverses(x, "inferior_frontal_gyrus", h)
     | traverses(x, "middle_frontal_gyrus", h)),
    traverses(x, "inferiorparietal", h), ~mdlf(x, h), ~slf_i(x, h),
    ~slf_ii(x, h), ~slf_iii(x, h), ~ioff(x, h), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o)

% CC = (
%   (
%     (frontal.left and frontal.right) or
%     (parietal.left and parietal.right) or
%     (occipital.left and occipital.right) or
%     (cingular.left and cingular.right)
%   ) and
%   (corpuscallosum.left or corpuscallosum.right)
% )
cc(x) :-
    ((traverses(x, "frontal", "left"), traverses(x, "frontal", "right"))
     | (traverses(x, "parietal", "left"), traverses(x, "parietal", "right"))
     | (traverses(x, "occipital", "left"), traverses(x, "occipital", "right"))
     | (traverses(x, "cingular", "left"), traverses(x, "cingular", "right"))),
    (traverses(x, "corpuscallosum", "left")
     | traverses(x, "corpuscallosum", "right"))

% internal_capsule.side |= ((rostralmiddlefrontal.side and temporal.side and Putamen.side and centrum_semiovale.side)
%         not in occipital.side not in corpus_callosum not in cerebellum
%         not in HEMISPHERE.opposite
%         not in subcortical.side not in cingular.side
% )
internal_capsule(x, h) :-
    traverses(x, "rostralmiddlefrontal", h), traverses(x, "temporal", h),
    traverses(x, "putamen", h), traverses(x, "centrum_semiovale", h),
    ~traverses(x, "occipital", h), ~traverses(x, "corpus_callosum", _),
    ~traverses(x, "cerebellum", _), opposite_hemisphere(h, o),
    ~in_hemisphere(x, o), ~traverses(x, "subcortical", h),
    ~traverses(x, "cingular", h)

% mdlf_probable_sections.side |= only( (precentral.side or paracentral.side or postcentral.side or superiorparietal.side) and unsegmentedwhitematter.side and temporal.side)
mdlf_probable_sections_leaves(x, h) :-
    in_hemisphere(x, h), streamline_label(a, x, l),
    ~term_label(a, l, "precentral", h), ~term_label(a, l, "paracentral", h),
    ~term_label(a, l, "postcentral", h),
    ~term_label(a, l, "superiorparietal", h),
    ~term_label(a, l, "unsegmentedwhitematter", h),
    ~term_label(a, l, "temporal", h)
mdlf_probable_sections(x, h) :-
    (traverses(x, "precentral", h) | traverses(x, "paracentral", h)
     | traverses(x, "postcentral", h) | traverses(x, "superiorparietal", h)),
    traverses(x, "unsegmentedwhitematter", h), traverses(x, "temporal", h),
    ~mdlf_probable_sections_leaves(x, h)

% AF.side = ((   (inferior_frontal_gyrus.side or middle_frontal_gyrus.side or precentral.side)
%     and (superiortemporal.side or middletemporal.side))
%     not in SLF_II.side not in SLF_III.side not in MDLF.side not in IOFF.side not in ILF.side
%     not in extreme_capsule.side
%         not in insula.side not in centrum_semiovale.side
%     not in occipital.side not in temporalpole.side not in medialorbitofrontal.side
%     not in lateralorbitofrontal.side
% )
af(x, h) :-
    (traverses(x, "inferior_frontal_gyrus", h)
     | traverses(x, "middle_frontal_gyrus", h)
     | traverses(x, "precentral", h)),
    (traverses(x, "superiortemporal", h) | traverses(x, "middletemporal", h)),
    ~slf_ii(x, h), ~slf_iii(x, h), ~mdlf(x, h), ~ioff(x, h), ~ilf(x, h),
    ~extreme_capsule(x, h), ~traverses(x, "insula", h),
    ~traverses(x, "centrum_semiovale", h), ~traverses(x, "occipital", h),
    ~traverses(x, "temporalpole", h), ~traverses(x, "medialorbitofrontal", h),
    ~traverses(x, "lateralorbitofrontal", h)

% thalamo_frontal.side = endpoints_in(thalamus_proper.side) and endpoints_in(frontal.side)
thalamo_frontal(x, h) :-
    ends_in(x, "thalamus_proper", h), ends_in(x, "frontal", h)

% thalamo_parietal.side = endpoints_in(thalamus_proper.side) and endpoints_in(parietal.side)
thalamo_parietal(x, h) :-
    ends_in(x, "thalamus_proper", h), ends_in(x, "parietal", h)

% thalamo_occipital.side = endpoints_in(thalamus_proper.side) and endpoints_in(occipital.side)
thalamo_occipital(x, h) :-
    ends_in(x, "thalamus_proper", h), ends_in(x, "occipital", h)

% striato_frontal.side = endpoints_in(striatum.side) and endpoints_in(frontal.side)
striato_frontal(x, h) :-
    ends_in(x, "striatum", h), ends_in(x, "frontal", h)

% striato_parietal.side = endpoints_in(striatum.side) and endpoints_in(parietal.side)
striato_parietal(x, h) :-
    ends_in(x, "striatum", h), ends_in(x, "parietal", h)

% striato_occipital.side = endpoints_in(striatum.side) and endpoints_in(occipital.side)
striato_occipital(x, h) :-
    ends_in(x, "striatum", h), ends_in(x, "occipital", h)

% cc_1 = endpoints_in(orbitofrontalgyrus.left) and endpoints_in(orbitofrontalgyrus.right)
cc_1(x) :-
    ends_in(x, "orbitofrontalgyrus", "left"),
    ends_in(x, "orbitofrontalgyrus", "right")

% cc_2 = endpoints_in(parstriangularis.left or parsorbitalis.left or superiorfrontal.left or rostralmiddlefrontal.left or frontalpole.left) and  endpoints_in(parstriangularis.right or parsorbitalis.right or superiorfrontal.right or rostralmiddlefrontal.right or frontalpole.right)
cc_2(x) :-
    (ends_in(x, "parstriangularis", "left")
     | ends_in(x, "parsorbitalis", "left")
     | ends_in(x, "superiorfrontal", "left")
     | ends_in(x, "rostralmiddlefrontal", "left")
     | ends_in(x, "frontalpole", "left")),
    (ends_in(x, "parstriangularis", "right")
     | ends_in(x, "parsorbitalis", "right")
     | ends_in(x, "superiorfrontal", "right")
     | ends_in(x, "rostralmiddlefrontal", "right")
     | ends_in(x, "frontalpole", "right"))

% cc_3 = endpoints_in(rostralanteriorcingulate.left or caudalanteriorcingulate.left or caudalmiddlefrontal.left or parsopercularis.left) and  endpoints_in(rostralanteriorcingulate.right or caudalanteriorcingulate.right or caudalmiddlefrontal.right or parsopercularis.right)
cc_3(x) :-
    (ends_in(x, "rostralanteriorcingulate", "left")
     | ends_in(x, "caudalanteriorcingulate", "left")
     | ends_in(x, "caudalmiddlefrontal", "left")
     | ends_in(x, "parsopercularis", "left")),
    (ends_in(x, "rostralanteriorcingulate", "right")
     | ends_in(x, "caudalanteriorcingulate", "right")
     | ends_in(x, "caudalmiddlefrontal", "right")
     | ends_in(x, "parsopercularis", "right"))

% cc_4 = endpoints_in(precentral.left) and endpoints_in(precentral.right)
cc_4(x) :-
    ends_in(x, "precentral", "left"), ends_in(x, "precentral", "right")

% cc_5 = endpoints_in(postcentral.left or posteriorcingulate.left or paracentral.left) and endpoints_in(postcentral.right or posteriorcingulate.right or paracentral.right) and corpuscallosum.left and corpuscallosum.right
cc_5(x) :-
    (ends_in(x, "postcentral", "left")
     | ends_in(x, "posteriorcingulate", "left")
     | ends_in(x, "paracentral", "left")),
    (ends_in(x, "postcentral", "right")
     | ends_in(x, "posteriorcingulate", "right")
     | ends_in(x, "paracentral", "right")),
    traverses(x, "corpuscallosum", "left"),
    traverses(x, "corpuscallosum", "right")

% cc_6 = endpoints_in(precuneus.left or supramarginal.left or superiorparietal.left or inferiorparietal.left or superiortemporal.left or middletemporal.left or bankssts.left or transversetemporal.left or isthmuscingulate.left) and endpoints_in(precuneus.right or supramarginal.right or superiorparietal.right or inferiorparietal.right or superiortemporal.right or middletemporal.right or bankssts.right or transversetemporal.right or isthmuscingulate.right) and corpuscallosum.left and corpuscallosum.right
cc_6(x) :-
    (ends_in(x, "precuneus", "left") | ends_in(x, "supramarginal", "left")
     | ends_in(x, "superiorparietal", "left")
     | ends_in(x, "inferiorparietal", "left")
     | ends_in(x, "superiortemporal", "left")
     | ends_in(x, "middletemporal", "left") | ends_in(x, "bankssts", "left")
     | ends_in(x, "transversetemporal", "left")
     | ends_in(x, "isthmuscingulate", "left")),
    (ends_in(x, "precuneus", "right") | ends_in(x, "supramarginal", "right")
     | ends_in(x, "superiorparietal", "right")
     | ends_in(x, "inferiorparietal", "right")
     | ends_in(x, "superiortemporal", "right")
     | ends_in(x, "middletemporal", "right") | ends_in(x, "bankssts", "right")
     | ends_in(x, "transversetemporal", "right")
     | ends_in(x, "isthmuscingulate", "right")),
    traverses(x, "corpuscallosum", "left"),
    traverses(x, "corpuscallosum", "right")

% cc_7 = endpoints_in(occipital.left or fusiform.left or lingual.left or inferiortemporal.left) and endpoints_in(occipital.right or fusiform.right or lingual.right or inferiortemporal.right)
cc_7(x) :-
    (ends_in(x, "occipital", "left") | ends_in(x, "fusiform", "left")
     | ends_in(x, "lingual", "left") | ends_in(x, "inferiortemporal", "left")),
    (ends_in(x, "occipital", "right") | ends_in(x, "fusiform", "right")
     | ends_in(x, "lingual", "right")
     | ends_in(x, "inferiortemporal", "right"))
